\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Real-data workflow validation. Two-panel figure: \textbf  {(a)} Cross-task p-value scatter showing all tasks $\times $ workflows $\times $ modes. Each row groups the three workflows for one task; each mode is color-coded. The dashed vertical line marks the $0.05$ decision threshold. \textbf  {(b)} Effective sample sizes (Kish's ESS) for source and target under the doubly weighted mode. The two bars per task show how much of each group's data survives the common-support restriction; the gap between ESS and the original sample size (not shown) diagnoses the extent of weak-overlap contamination.}}{8}{figure.caption.19}\protected@file@percent }
\newlabel{fig:real-data-workflow}{{5}{8}{Real-data workflow validation. Two-panel figure: \textbf {(a)} Cross-task p-value scatter showing all tasks $\times $ workflows $\times $ modes. Each row groups the three workflows for one task; each mode is color-coded. The dashed vertical line marks the $0.05$ decision threshold. \textbf {(b)} Effective sample sizes (Kish's ESS) for source and target under the doubly weighted mode. The two bars per task show how much of each group's data survives the common-support restriction; the gap between ESS and the original sample size (not shown) diagnoses the extent of weak-overlap contamination}{figure.caption.19}{}}
